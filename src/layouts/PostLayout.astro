---
import '../styles/global.css';
import ReadingUI from '../components/ReadingUI.astro';

const { frontmatter, url } = Astro.props;
const fm = frontmatter;
const slug = (url || '').split('/').filter(Boolean).pop() || 'post';
const lines = fm.titleLines ?? [fm.title];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fm.title}</title>
    <meta name="description" content={fm.description ?? ''} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    

    <div class="shell">
      <header class="masthead">
        <p class="eyebrow">{fm.eyebrow ?? 'AI PRACTICE / NOTES'}</p>
        <h1>
          {lines.map((l, i) => (
            <span class={i === lines.length - 1 && fm.highlightLast ? 'hl' : ''}>{l}</span>
          ))}
        </h1>
        {fm.description && <p class="lede">{fm.description}</p>}
        <div class="meta">
          <span class="mono">{fm.date}</span>
          <span class="sep"></span>
          <span>読了 約{fm.minutes}分</span>
          <span class="sep"></span>
          <span>{fm.category ?? '考え方 / 実践メモ'}</span>
        </div>
      </header>

      <div class="columns">
        <article class="prose"><slot /></article>
        <ReadingUI slug={slug} />
      </div>

      <footer class="post-footer">
        <p>今後も、実際にやったことをもとに書いていきます。</p>
        <p><a href="/">← 一覧に戻る</a></p>
      </footer>
    </div>
  </body>
</html>
